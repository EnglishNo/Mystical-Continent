  <script>
    // ============================================================================
    // 1. Web Audio API 레트로 아케이드 사운드 엔진
    // ============================================================================
    class RetroSoundEngine {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }
      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
      }
      play(type) {
        if (!this.enabled) return;
        try {
          this.init();
          if (!this.ctx) return;
          if (this.ctx.state === 'suspended') this.ctx.resume();
          const now = this.ctx.currentTime;

          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.connect(gain);
          gain.connect(this.ctx.destination);

          if (type === 'slash1' || type === 'slash2') {
            osc.type = 'sawtooth';
            const startF = type === 'slash1' ? 360 : 480;
            osc.frequency.setValueAtTime(startF, now);
            osc.frequency.exponentialRampToValueAtTime(85, now + 0.11);
            gain.gain.setValueAtTime(0.14, now);
            gain.gain.linearRampToValueAtTime(0.01, now + 0.11);
            osc.start(now);
            osc.stop(now + 0.11);
          } else if (type === 'slash3') {
            osc.type = 'square';
            osc.frequency.setValueAtTime(580, now);
            osc.frequency.exponentialRampToValueAtTime(110, now + 0.22);
            gain.gain.setValueAtTime(0.18, now);
            gain.gain.linearRampToValueAtTime(0.01, now + 0.22);
            osc.start(now);
            osc.stop(now + 0.22);
          } else if (type === 'hit') {
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(190, now);
            osc.frequency.exponentialRampToValueAtTime(45, now + 0.09);
            gain.gain.setValueAtTime(0.20, now);
            gain.gain.linearRampToValueAtTime(0.01, now + 0.09);
            osc.start(now);
            osc.stop(now + 0.09);
          } else if (type === 'dodge') {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(340, now);
            osc.frequency.exponentialRampToValueAtTime(880, now + 0.15);
            gain.gain.setValueAtTime(0.13, now);
            gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
            osc.start(now);
            osc.stop(now + 0.15);
          } else if (type === 'heavy') {
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(150, now);
            osc.frequency.exponentialRampToValueAtTime(32, now + 0.35);
            gain.gain.setValueAtTime(0.22, now);
            gain.gain.linearRampToValueAtTime(0.01, now + 0.35);
            osc.start(now);
            osc.stop(now + 0.35);
          } else if (type === 'magic') {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(660, now);
            osc.frequency.exponentialRampToValueAtTime(240, now + 0.22);
            gain.gain.setValueAtTime(0.14, now);
            gain.gain.linearRampToValueAtTime(0.01, now + 0.22);
            osc.start(now);
            osc.stop(now + 0.22);
          } else if (type === 'levelup') {
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(523.25, now);
            osc.frequency.setValueAtTime(659.25, now + 0.07);
            osc.frequency.setValueAtTime(783.99, now + 0.14);
            osc.frequency.setValueAtTime(1046.5, now + 0.21);
            gain.gain.setValueAtTime(0.16, now);
            gain.gain.linearRampToValueAtTime(0.01, now + 0.42);
            osc.start(now);
            osc.stop(now + 0.42);
          }
        } catch (err) {}
      }
    }
    const soundFX = new RetroSoundEngine();

    // ============================================================================
    // 2. 2020s 모던 서브컬쳐 128×128 SD 도트 엔진 (블루아카이브/명일방주/산나비 감성 무광 시크 눈매 & 남/여 완벽 분리)
    // ============================================================================
    const hdSpriteCache = {};

    function createPixelSurface(size = 128) {
      const off = document.createElement('canvas');
      off.width = size;
      off.height = size;
      const g = off.getContext('2d');
      g.imageSmoothingEnabled = true;
      return { canvas: off, g };
    }

    // 1x1 정밀 128x128 도트 그리드 스냅 & 셀셰이딩 외곽선 처리
    function quantizeToSubculturePixelArt(sourceCanvas, gridStep = 1) {
      const w = sourceCanvas.width;
      const h = sourceCanvas.height;
      const ctx = sourceCanvas.getContext('2d');
      const srcData = ctx.getImageData(0, 0, w, h);
      const s = srcData.data;
      const outData = ctx.createImageData(w, h);
      const d = outData.data;

      const gw = Math.floor(w / gridStep);
      const gh = Math.floor(h / gridStep);
      const gridAlpha = new Uint8Array(gw * gh);
      const gridR = new Uint8Array(gw * gh);
      const gridG = new Uint8Array(gw * gh);
      const gridB = new Uint8Array(gw * gh);

      for (let gy = 0; gy < gh; gy++) {
        for (let gx = 0; gx < gw; gx++) {
          const px = gx * gridStep;
          const py = gy * gridStep;
          const idx = (py * w + px) * 4;
          const a = s[idx + 3];
          const gIdx = gy * gw + gx;
          if (a >= 105) {
            gridAlpha[gIdx] = 255;
            gridR[gIdx] = Math.min(255, Math.round(s[idx] / 10) * 10);
            gridG[gIdx] = Math.min(255, Math.round(s[idx + 1] / 10) * 10);
            gridB[gIdx] = Math.min(255, Math.round(s[idx + 2] / 10) * 10);
          } else {
            gridAlpha[gIdx] = 0;
          }
        }
      }

      for (let gy = 0; gy < gh; gy++) {
        for (let gx = 0; gx < gw; gx++) {
          const gIdx = gy * gw + gx;
          let r = gridR[gIdx], g = gridG[gIdx], b = gridB[gIdx], a = gridAlpha[gIdx];
          if (a > 0) {
            const isEdge =
              gx === 0 || gx === gw - 1 || gy === 0 || gy === gh - 1 ||
              gridAlpha[gIdx - 1] === 0 || gridAlpha[gIdx + 1] === 0 ||
              gridAlpha[gIdx - gw] === 0 || gridAlpha[gIdx + gw] === 0;
            if (isEdge) {
              r = 24; g = 20; b = 34;
            }
            for (let dy = 0; dy < gridStep; dy++) {
              for (let dx = 0; dx < gridStep; dx++) {
                const pIdx = ((gy * gridStep + dy) * w + (gx * gridStep + dx)) * 4;
                d[pIdx] = r;
                d[pIdx + 1] = g;
                d[pIdx + 2] = b;
                d[pIdx + 3] = 255;
              }
            }
          }
        }
      }
      ctx.putImageData(outData, 0, 0);
    }

    function drawRoundPart(g, cx, cy, rx, ry, rot, fillStyle, strokeStyle = '#181422', lw = 2.2) {
      g.save();
      g.translate(cx, cy);
      if (rot) g.rotate(rot);
      g.beginPath();
      g.ellipse(0, 0, rx, ry, 0, 0, Math.PI * 2);
      g.fillStyle = fillStyle;
      g.fill();
      if (strokeStyle) {
        g.strokeStyle = strokeStyle;
        g.lineWidth = lw;
        g.stroke();
      }
      g.restore();
    }

    function drawRoundedRectPath(g, x, y, w, h, r, fillStyle, strokeStyle = '#181422', lw = 2.2) {
      g.save();
      g.beginPath();
      g.roundRect(x, y, w, h, r);
      g.fillStyle = fillStyle;
      g.fill();
      if (strokeStyle) {
        g.strokeStyle = strokeStyle;
        g.lineWidth = lw;
        g.stroke();
      }
      g.restore();
    }

    // 2020년대 모던 서브컬쳐 SD 캐릭터 렌더러
    // - 80~90년대식 초롱초롱한 하얀 안광 구슬(Starry catchlights) 완전 제거!
    // - 시크하고 플랫한 반무광(Matte) 일자/반달 아이라인 + 차분한 하단 톤온톤 홍채
    // - 남성(male) 캐릭터는 날렵한 투블럭/숏 레이어드 컷과 코트/바지/갑주 착용
    function drawSubcultureSDCharacter(g, cfg) {
      const cx = 64;
      const headY = 46;
      const isMale = cfg.gender === 'male';

      // 1) 망토 / 코트 자락
      if (cfg.capeColor) {
        g.save();
        g.beginPath();
        g.moveTo(cx - 19, 66);
        g.bezierCurveTo(cx - 34, 82, cx - 32, 106, cx - 22, 112);
        g.lineTo(cx + 22, 112);
        g.bezierCurveTo(cx + 32, 106, cx + 34, 82, cx + 19, 66);
        g.closePath();
        g.fillStyle = cfg.capeColor;
        g.fill();
        g.strokeStyle = '#181422';
        g.lineWidth = 2.2;
        g.stroke();
        g.restore();
      }

      // 뒷머리 (남성은 깔끔한 숏 네이프, 여성은 레이어드 롱/단발/트윈)
      if (!isMale && cfg.hairBackStyle === 'long_wave') {
        g.save();
        g.beginPath();
        g.moveTo(cx - 24, 38);
        g.bezierCurveTo(cx - 34, 58, cx - 32, 90, cx - 20, 102);
        g.lineTo(cx + 20, 102);
        g.bezierCurveTo(cx + 32, 90, cx + 34, 58, cx + 24, 38);
        g.closePath();
        g.fillStyle = cfg.hairDark;
        g.fill();
        g.strokeStyle = '#181422';
        g.lineWidth = 2.2;
        g.stroke();
        g.restore();
      } else if (!isMale && cfg.hairBackStyle === 'twintail') {
        [-1, 1].forEach(dir => {
          g.save();
          g.beginPath();
          g.moveTo(cx + dir * 21, 36);
          g.bezierCurveTo(cx + dir * 38, 44, cx + dir * 39, 76, cx + dir * 28, 94);
          g.bezierCurveTo(cx + dir * 20, 88, cx + dir * 19, 62, cx + dir * 17, 42);
          g.closePath();
          g.fillStyle = cfg.hairBase;
          g.fill();
          g.strokeStyle = '#181422';
          g.lineWidth = 2.2;
          g.stroke();
          g.restore();
        });
      } else {
        drawRoundPart(g, cx, headY + 3, 27, 22, 0, cfg.hairDark);
      }

      // 2) 다리 & 부츠 (남성은 다크 팬츠와 워커 부츠, 여성은 부츠)
      if (isMale) {
        drawRoundedRectPath(g, cx - 14, 92, 11, 16, 4, '#1e293b');
        drawRoundedRectPath(g, cx + 3, 92, 11, 16, 4, '#1e293b');
      }
      drawRoundPart(g, cx - 8.5, 109, 6, 7.5, 0.04, cfg.bootColor || '#1e293b');
      drawRoundPart(g, cx + 8.5, 109, 6, 7.5, -0.04, cfg.bootColor || '#1e293b');

      // 3) 의상 (남성: 모던 판타지 재킷/코트/갑주, 여성: 세련된 원피스/코트)
      g.save();
      g.beginPath();
      if (!isMale && cfg.isDress) {
        g.moveTo(cx - 14, 66);
        g.bezierCurveTo(cx - 22, 82, cx - 25, 97, cx - 22, 103);
        g.quadraticCurveTo(cx, 107, cx + 22, 103);
        g.bezierCurveTo(cx + 25, 97, cx + 22, 82, cx + 14, 66);
      } else {
        g.moveTo(cx - 16, 66);
        g.bezierCurveTo(cx - 19, 78, cx - 18, 92, cx - 16, 98);
        g.quadraticCurveTo(cx, 101, cx + 16, 98);
        g.bezierCurveTo(cx + 18, 92, cx + 19, 78, cx + 16, 66);
      }
      g.closePath();
      g.fillStyle = cfg.outfitBase;
      g.fill();
      g.strokeStyle = '#181422';
      g.lineWidth = 2.2;
      g.stroke();
      g.restore();

      if (cfg.apronColor) {
        drawRoundedRectPath(g, cx - 11, 71, 22, 30, 5, cfg.apronColor, '#181422', 1.8);
      }
      if (cfg.trimColor) {
        drawRoundedRectPath(g, cx - 3.5, 67, 7, 29, 3, cfg.trimColor, '#181422', 1.6);
      }
      drawRoundPart(g, cx, 67, 11, 4.5, 0, cfg.collarColor || '#e2e8f0', '#181422', 1.8);

      // 4) 팔과 손
      drawRoundPart(g, cx - 18, 78, 5.5, 10.5, 0.25, cfg.sleeveColor || cfg.outfitBase);
      drawRoundPart(g, cx + 18, 78, 5.5, 10.5, -0.25, cfg.sleeveColor || cfg.outfitBase);
      drawRoundPart(g, cx - 20, 86, 4.2, 4.2, 0, '#fff1e6');
      drawRoundPart(g, cx + 20, 86, 4.2, 4.2, 0, '#fff1e6');

      // 5) 얼굴 윤곽 (남성은 조금 더 샤프한 턱선, 여성은 부드러운 턱선)
      drawRoundPart(g, cx - 23, headY + 3, 4, 5.5, -0.1, '#fff1e6');
      drawRoundPart(g, cx + 23, headY + 3, 4, 5.5, 0.1, '#fff1e6');

      g.save();
      g.beginPath();
      g.moveTo(cx, headY - 23);
      g.bezierCurveTo(cx + 21, headY - 23, cx + 25, headY - 4, cx + 23, headY + 8);
      g.bezierCurveTo(cx + 20, headY + 18, cx + 8, headY + 23, cx, headY + 23);
      g.bezierCurveTo(cx - 8, headY + 23, cx - 20, headY + 18, cx - 23, headY + 8);
      g.bezierCurveTo(cx - 25, headY - 4, cx - 21, headY - 23, cx, headY - 23);
      g.closePath();
      g.fillStyle = '#fff3eb';
      g.fill();
      g.strokeStyle = '#181422';
      g.lineWidth = 2.4;
      g.stroke();
      g.restore();

      // 6) 2020s 모던 서브컬쳐 눈매 (초롱초롱한 왕눈이/하얀 안광 구슬 완전 배제! 플랫/세미매트 시크 아이라인)
      if (cfg.isElder) {
        // 인자한 할아버지 촌장: 부드러운 일자 반달 눈매 + 구름형 백수염
        [-1, 1].forEach(dir => {
          const ex = cx + dir * 9.5;
          g.save();
          g.beginPath();
          g.moveTo(ex - 4.5, headY + 4);
          g.quadraticCurveTo(ex, headY + 1.5, ex + 4.5, headY + 4);
          g.strokeStyle = '#1e293b';
          g.lineWidth = 2.8;
          g.lineCap = 'round';
          g.stroke();
          drawRoundedRectPath(g, ex - 5, headY - 4, 10, 3.2, 1.5, '#f8fafc', '#181422', 1.5);
          g.restore();
        });
        // 구름형 둥근 백수염
        g.save();
        g.beginPath();
        g.moveTo(cx - 17, headY + 13);
