      if (!skipAutoSave) {
        saveSync.allowResetOnce = true;
        savePlayerProgress('새 게임 초기화');
      }
      addLog(`🔄 [새 게임 초기화] Lv.1 ${c.name} 초기 상태로 리셋되었습니다.`);
    }

    function spawnParticles(x, y, count, colors, speedMax = 190, sizeMax = 5, ttlMax = 0.55) {
      for (let i = 0; i < count; i++) {
        const ang = Math.random() * Math.PI * 2;
        const spd = 30 + Math.random() * speedMax;
        state.particles.push({
          x, y,
          vx: Math.cos(ang) * spd,
          vy: Math.sin(ang) * spd - 25,
          size: 2 + Math.floor(Math.random() * sizeMax),
          color: colors[Math.floor(Math.random() * colors.length)],
          ttl: 0.2 + Math.random() * ttlMax,
          maxTtl: ttlMax
        });
      }
    }

    function addLog(msg) {
      state.logs.unshift(msg);
      if (state.logs.length > 18) state.logs.pop();
      renderLogs();
    }

    function closeNpcDialog() {
      if (!state.isTalkingToNpc) return;
      state.isTalkingToNpc = false;
      document.getElementById('npcDialogBox').classList.add('hidden');
      addLog('▶️ [NPC 대화 종료] 월드 일시정지가 해제되어 전투와 이동이 재개됩니다.');
    }

    // ============================================================================
    // 5. 센서 액션 & NPC 대화창 토글/일시정지 처리
    // ============================================================================
    function triggerSensorAction(actionKey, sourceLabel) {
      if (!isGameViewVisible() || state.gameOver || state.isModalOpen) return;

      if (state.isTalkingToNpc) {
        if (actionKey === 'interact') {
          closeNpcDialog();
        }
        return;
      }

      if (state.cooldownLeft[actionKey] > 0) return;

      const p = state.player;
      const derived = getDerivedStats();

      if (actionKey === 'magic_skill' && p.mp < 15) {
        addLog('[마나 부족] 3연발 화염구 발사에 마나 15가 필요합니다.');
        return;
      }
      if (actionKey === 'special_skill' && p.mp < 30) {
        addLog('[마나 부족] 아케인 마법진 소환에 마나 30이 필요합니다.');
        return;
      }

      state.cooldownLeft[actionKey] = COOLDOWNS[actionKey];
      state.sensor.lastAction = `${sourceLabel} ➔ ${actionKey}`;
      state.sensor.actionCount += 1;

      const aimAngle = Math.atan2(p.fy, p.fx);

      if (actionKey === 'dodge') {
        const dodgeLv = getClampedSkillLevel(p.skills.dodge);
        const invulnSec = +(0.52 + (dodgeLv - 1) * 0.025).toFixed(2);
        const mpBonus = 25 + (dodgeLv - 1) * 3;
        soundFX.play('dodge');
        state.sensor.gyroDeg = 195.0;
        state.sensor.roll = 42 * (p.fx >= 0 ? 1 : -1);
        p.dodgeTimer = 0.26;
        p.invulnTimer = invulnSec;

        const nearTelegraph = state.monsters.some(m =>
          m.zone === state.zoneId && m.alive && m.state === 'TELEGRAPH' && Math.hypot(m.x - p.x, m.y - p.y) <= 185
        );
        if (nearTelegraph) {
          state.bulletTimeTimer = 1.45;
          p.mp = Math.min(derived.maxMp, p.mp + mpBonus);
          state.screenShake = 8;
          spawnParticles(p.x, p.y, 32, ['#34d399', '#38bdf8', '#ffffff'], 240, 6, 0.6);
          state.effects.push({ kind: 'dmg_text', x: p.x, y: p.y - 32, text: `⚡ PERFECT DODGE! (MP+${mpBonus})`, color: '#34d399', ttl: 0.9 });
          addLog(`⚡ [저스트 회피 성공!] 자이로 급회전으로 적의 공격을 흘려보내 슬로우모션(Bullet-Time) 및 MP +${mpBonus} 회복이 발동합니다!`);
        } else {
          spawnParticles(p.x, p.y, 16, ['#34d399', '#38bdf8'], 150, 4, 0.35);
          addLog(`💨 [환영 회피 Lv.${dodgeLv}] 환영 잔상 대시! (${invulnSec}초 무적)`);
        }
      } else if (actionKey === 'basic_attack') {
        if (p.comboTimer > 0) {
          p.comboStep = (p.comboStep + 1) % 3;
        } else {
          p.comboStep = 0;
        }
        p.comboTimer = 0.95;

        const step = p.comboStep;
        const basicLv = getClampedSkillLevel(p.skills.basic_attack);
        const lvBonus = 1 + 0.20 * (basicLv - 1);
        const clsColor = (CLASSES[state.selectedClass] || CLASSES.knight).color;

        if (step === 0) {
          soundFX.play('slash1');
          state.slashArcs.push({
            x: p.x + p.fx * 10, y: p.y + p.fy * 10, angle: aimAngle, sweep: Math.PI * 0.85,
            radius: 70 + basicLv * 3, dir: 1,
            color: clsColor, coreColor: '#ffffff', ttl: 0.18, maxTtl: 0.18
          });
          performMeleeHit(p.x, p.y, p.fx, p.fy, 74 + basicLv * 3, 1.0 * lvBonus, '⚔️ [1단 베기]', false, 95);
        } else if (step === 1) {
          soundFX.play('slash2');
          state.slashArcs.push({
            x: p.x + p.fx * 12, y: p.y + p.fy * 12, angle: aimAngle, sweep: Math.PI * 0.95,
            radius: 78 + basicLv * 3, dir: -1,
            color: '#fbbf24', coreColor: '#ffffff', ttl: 0.20, maxTtl: 0.20
          });
          performMeleeHit(p.x, p.y, p.fx, p.fy, 82 + basicLv * 3, 1.30 * lvBonus, '⚔️ [2단 교차참]', false, 130);
        } else {
          soundFX.play('slash3');
          state.screenShake = 7;
          state.slashArcs.push({
            x: p.x, y: p.y, angle: aimAngle, sweep: Math.PI * 1.95,
            radius: 96 + basicLv * 4, dir: 1,
            color: '#f43f5e', coreColor: '#fde047', ttl: 0.26, maxTtl: 0.26
          });
          spawnParticles(p.x, p.y, 24, ['#f43f5e', '#fbbf24', '#ffffff'], 220, 5, 0.45);
          performMeleeHit(p.x, p.y, p.fx, p.fy, 98 + basicLv * 4, 1.80 * lvBonus, '🌪️ [3단 회전참!]', false, 210);
        }
      } else if (actionKey === 'heavy_attack') {
        const heavyLv = getClampedSkillLevel(p.skills.heavy_attack);
        soundFX.play('heavy');
        state.sensor.accelG = 2.65;
        state.sensor.pitch = -35;
        state.screenShake = 14;
        const rad = 126 + (heavyLv - 1) * 6;
        state.effects.push({ kind: 'quake_crater', x: p.x, y: p.y, r: rad, ttl: 0.55, maxTtl: 0.55 });
        spawnParticles(p.x, p.y, 42, ['#f43f5e', '#f97316', '#fde047', '#ffffff'], 280, 6, 0.65);
        performMeleeHit(p.x, p.y, p.fx, p.fy, rad, 2.40 + 0.32 * (heavyLv - 1), '💥 [가속도 2.65G 대지 분쇄]', true, 280);
      } else if (actionKey === 'magic_skill') {
        const magicLv = getClampedSkillLevel(p.skills.magic_skill);
        soundFX.play('magic');
        state.sensor.touch0Active = true;
        setTimeout(() => { state.sensor.touch0Active = false; }, 300);
        p.mp = Math.max(0, p.mp - 15);
        const spreadAngles = [-0.22, 0, 0.22];
        spreadAngles.forEach(offset => {
          const ang = aimAngle + offset;
          state.projectiles.push({
            x: p.x + Math.cos(ang) * 20,
            y: p.y + Math.sin(ang) * 20,
            vx: Math.cos(ang) * 430,
            vy: Math.sin(ang) * 430,
            r: 12,
            dmg: Math.round(derived.atk * (1.40 + 0.25 * (magicLv - 1))),
            color: '#f97316',
            ttl: 1.5,
            isEnemy: false
          });
        });
        spawnParticles(p.x + p.fx * 20, p.y + p.fy * 20, 18, ['#f97316', '#fde047', '#c084fc'], 170, 5, 0.4);
        addLog('🔥 [터치 센서 T0] 3연발 확산 플라즈마 화염구 발사!');
      } else if (actionKey === 'special_skill') {
        const specLv = getClampedSkillLevel(p.skills.special_skill);
        soundFX.play('heavy');
        state.sensor.touch3Active = true;
        setTimeout(() => { state.sensor.touch3Active = false; }, 450);
        p.mp = Math.max(0, p.mp - 30);
        state.screenShake = 18;
        const rad = 190 + (specLv - 1) * 7;
        state.effects.push({ kind: 'arcane_circle', x: p.x, y: p.y, r: rad, ttl: 0.85, maxTtl: 0.85 });
        spawnParticles(p.x, p.y, 60, ['#c084fc', '#38bdf8', '#fde047', '#ffffff'], 340, 7, 0.8);
        performMeleeHit(p.x, p.y, p.fx, p.fy, rad, 3.20 + 0.42 * (specLv - 1), '✨ [터치 센서 T3 아케인 마법진]', true, 320);
      } else if (actionKey === 'interact') {
        handleWorldInteraction();
      }
    }

    function performMeleeHit(originX, originY, fx, fy, radius, mult, label, isHeavyCounter, knockbackForce = 120) {
      const p = state.player;
      const derived = getDerivedStats();
      const cx = originX + (radius < 100 ? fx * 26 : 0);
      const cy = originY + (radius < 100 ? fy * 26 : 0);

      let hitAny = false;
      state.monsters.forEach(m => {
        if (m.zone === state.zoneId && m.alive) {
          const dist = Math.hypot(m.x - cx, m.y - cy);
          if (dist <= radius + m.r) {
            hitAny = true;
            const isCrit = Math.random() < derived.crit;
            let dmg = Math.round(derived.atk * mult * (isCrit ? 1.55 : 1.0));
            let isCounterHit = false;

            if (isHeavyCounter && m.isBoss && m.state === 'VULNERABLE') {
              dmg = Math.round(dmg * 2.5);
              isCounterHit = true;
              m.state = 'CHASE';
              state.screenShake = 22;
              addLog(`⚡ [2.5배 보스 카운터 작렬!!] ${m.name}에게 ${dmg} 극대 피해!`);
            } else {
              addLog(`${label} ➔ [Lv.${m.lv} ${m.name}]에게 ${dmg}${isCrit ? ' (치명타!)' : ''} 피해!`);
            }

            m.hp = Math.max(0, m.hp - dmg);
            m.flash = 0.18;

            if (m.isBoss && !m.enraged && m.hp > 0 && (m.hp / m.maxHp) <= 0.5) {
              m.enraged = true;
              state.screenShake = 20;
              spawnParticles(m.x, m.y, 50, ['#f43f5e', '#fde047', '#ffffff'], 300, 7, 0.8);
              addLog('🔥 [보스 광폭화 돌입!!] 드래곤 로드 발록의 공격 속도와 화염 탄막이 대폭 강화됩니다!');
            }

            const nx = (m.x - originX) / Math.max(1, dist);
            const ny = (m.y - originY) / Math.max(1, dist);
            const kb = m.isBoss ? knockbackForce * 0.22 : knockbackForce * 0.65;
            m.vx = nx * kb;
            m.vy = ny * kb;

            p.hitCount += 1;
            p.hitComboDecay = 3.0;

            spawnParticles(m.x, m.y, isCounterHit ? 35 : 16, isCounterHit ? ['#fde047', '#f43f5e', '#ffffff'] : ['#f43f5e', '#fbbf24', '#ffffff'], 220, 5, 0.45);
            state.effects.push({
              kind: 'dmg_text',
              x: m.x + (Math.random() * 16 - 8),
              y: m.y - 24,
              text: isCounterHit ? `⚡COUNTER -${dmg}!` : (isCrit ? `💥CRIT -${dmg}!` : `-${dmg}`),
              color: isCounterHit ? '#fde047' : (isCrit ? '#fb923c' : '#ffffff'),
              ttl: 0.65
            });

            if (m.hp <= 0) {
              onMonsterDefeated(m);
            }
          }
        }
      });

      if (hitAny) {
        soundFX.play('hit');
        state.hitStopTimer = 0.028;
      }
    }

    // 퀘스트 선행 조건 충족 여부 확인 (이전 퀘스트 클리어 + 최소 레벨 조건)
    function isQuestPrerequisiteMet(q) {
      if (!q) return false;
      if (state.player.level < (q.prereqMinLevel || 1)) return false;
      if (q.prereqQuestId) {
        const pre = state.questStates[q.prereqQuestId];
        if (!pre || pre.status !== 'completed') return false;
      }
      return true;
    }

    function getQuestState(qId) {
      if (!state.questStates[qId]) {
        state.questStates[qId] = { status: 'unaccepted', progress: 0 };
      }
      return state.questStates[qId];
    }

    function getActiveQuest() {
      // 현재 진행 중(active)인 메인 퀘스트 우선 반환, 없으면 수락 가능한 첫 메인 퀘스트 반환
      const activeMain = QUESTS.find(q => q.category === 'main' && getQuestState(q.id).status === 'active');
      if (activeMain) return activeMain;
      const activeSub = QUESTS.find(q => q.category === 'sub' && getQuestState(q.id).status === 'active');
      if (activeSub) return activeSub;
      const availMain = QUESTS.find(q => q.category === 'main' && getQuestState(q.id).status === 'unaccepted' && isQuestPrerequisiteMet(q));
      if (availMain) return availMain;
      return QUESTS[0];
    }

    // 사망한 위치 기준 가장 가까운 안전지대 마을 반환 (해변길 2·3 및 오션블루는 오션블루 타운, 그 외는 포레스트 타운)
    function getNearestTownZone(fromZoneId) {
      if (['coastal_road_2', 'coastal_road_3', 'oceanblue_town'].includes(fromZoneId)) {
        return 'oceanblue_town';
      }
      return 'forest_town';
    }

    // 플레이어 사망 처리: 경험치 5% 감소 + 사망 상태 및 부활할 인근 마을 서버 저장 + 사망 모달 표시
    function triggerPlayerDeath() {
      const p = state.player;
      p.hp = 0;
      const expLoss = p.exp > 0 ? Math.max(1, Math.round(p.exp * 0.05)) : 0;
      p.exp = Math.max(0, p.exp - expLoss);
      state.lastExpLost = expLoss;
      state.gameOver = true;
      state.playerDead = true;
      state.respawnTownId = getNearestTownZone(state.zoneId);
      const townName = state.zones[state.respawnTownId]?.name || '포레스트 타운';
      addLog(`💀 [전투 불능] 플레이어가 쓰러졌습니다! 경험치 5%(-${expLoss} EXP)가 감소했으며, 부활 시 인근 마을 [${townName}]에서 시작합니다.`);
      updateRealtimeTelemetryUI();
      savePlayerProgress(`사망 (EXP -${expLoss})`);
      showResultScreen(false);
    }

    // 인근 마을에서 부활 처리 (다시하기 버튼 또는 게임 종료 후 시작창에서 다시 게임 시작 시 호출)
    function revivePlayerAtNearestTown() {
      const derived = getDerivedStats();
      const targetTown = state.respawnTownId || getNearestTownZone(state.zoneId);
      state.gameOver = false;
      state.playerDead = false;
      state.player.hp = derived.maxHp;
      state.player.mp = derived.maxMp;
      state.projectiles = [];
      state.slashArcs = [];
      document.getElementById('resultModal').classList.add('hidden');
      switchZone(targetTown, 310, 300);
      addLog(`✨ [인근 마을 부활] 안전지대 [${state.zones[targetTown].name}]에서 체력과 마나를 모두 회복하고 부활했습니다!`);
      savePlayerProgress('인근 마을 부활');
    }

    function grantExpAndGold(expAmount, goldAmount, reasonText) {
      const p = state.player;
      p.exp += expAmount;
      p.gold += goldAmount;
      let leveled = false;
      while (p.exp >= p.expNext) {
        p.exp -= p.expNext;
        p.level += 1;
        p.expNext = Math.round(p.expNext * 1.35);
        p.baseHp += 34;
        p.baseAtk += 7;
        p.baseDef += 3;
        p.sp += 1;
        const derived = getDerivedStats();
        p.hp = derived.maxHp;
        p.mp = derived.maxMp;
        leveled = true;
        soundFX.play('levelup');
        state.effects.push({ kind: 'dmg_text', x: p.x, y: p.y - 48, text: `🎉 LEVEL UP! Lv.${p.level}`, color: '#fde047', ttl: 1.2 });
        addLog(`🎉 레벨 업! Lv.${p.level} 달성! (체력/공격력/방어력 상승 & SP +1)`);
      }
      savePlayerProgress(leveled ? `${reasonText} & Lv.${p.level}` : reasonText);
    }

    // NPC와 대화하여 조건 충족된 퀘스트 수락(시작)
        function formatGenderDialog(text) {
      if ((state.player?.gender || 'male') === 'female') {
        return text
          .replace(/우리 아들/g, '우리 딸')
          .replace(/내 아들아/g, '내 딸아')
          .replace(/마리아 부인의 아들이군/g, '마리아 부인의 딸이군');
      }
      return text;
    }

    function acceptQuestFromNpc(q, npcName) {
      const qs = getQuestState(q.id);
      qs.status = 'active';
      qs.progress = 0;

      // 메인 3장(부서진 무기 10개) 수락 시 이미 인벤토리에 보유한 수량 반영
      if (q.id === 'main_3') {
        const bw = state.player.inventory.find(i => i.id === 'broken_goblin_weapon');
        if (bw) qs.progress = Math.min(q.targetCount, bw.count);
      }
      // 메인 6장 수락 시 오션블루 타운 도착 목표 활성화
      if (q.id === 'main_6' && state.zoneId === 'oceanblue_town') {
        qs.progress = 1;
      }

      soundFX.play('levelup');
      spawnParticles(state.player.x, state.player.y, 28, ['#38bdf8', '#fde047', '#ffffff'], 210, 5, 0.6);
      state.effects.push({
        kind: 'dmg_text',
        x: state.player.x,
        y: state.player.y - 42,
        text: `📜 퀘스트 수락: ${q.title}`,
        color: '#38bdf8',
        ttl: 1.15
      });

      state.isTalkingToNpc = true;
      const box = document.getElementById('npcDialogBox');
      document.getElementById('npcDialogSpeaker').textContent = `❗ ${npcName} — 새로운 퀘스트 수락`;
      document.getElementById('npcDialogText').textContent = formatGenderDialog(q.startDialog);
      box.classList.remove('hidden');

      addLog(`📜 [퀘스트 수락] ${npcName}에게서 "${q.title}" 퀘스트를 받았습니다! (목표: ${q.objectiveLabel})`);
      savePlayerProgress(`${q.title} 수락`);
    }

    // 목표 달성 후 NPC와 대화하여 퀘스트 완료 & 보상 수령
    function completeQuestById(qId, npcName = '') {
      const q = QUESTS.find(item => item.id === qId);
      if (!q) return;
      const qs = getQuestState(q.id);
      if (qs.status !== 'active' || qs.progress < q.targetCount) {
        addLog(`[퀘스트 미달성] "${q.title}" 목표를 먼저 달성한 뒤 해당 NPC와 대화하세요 (${qs.progress}/${q.targetCount}).`);
        return;
      }

      if (q.id === 'main_3') {
        const bwIdx = state.player.inventory.findIndex(i => i.id === 'broken_goblin_weapon');
        if (bwIdx !== -1) {
          state.player.inventory[bwIdx].count -= 10;
          if (state.player.inventory[bwIdx].count <= 0) {
            state.player.inventory.splice(bwIdx, 1);
          }
        }
      }

      qs.status = 'completed';
      qs.progress = q.targetCount;

      soundFX.play('levelup');
      spawnParticles(state.player.x, state.player.y, 45, ['#fde047', '#34d399', '#38bdf8', '#ffffff'], 280, 6, 0.85);
      state.effects.push({
        kind: 'dmg_text',
        x: state.player.x,
        y: state.player.y - 44,
        text: `🎁 퀘스트 완료! +${q.rewardExp} EXP / +${q.rewardGold}G`,
        color: '#34d399',
        ttl: 1.25
      });

      state.isTalkingToNpc = true;
      const box = document.getElementById('npcDialogBox');
      document.getElementById('npcDialogSpeaker').textContent = `🎁 ${npcName || q.giver} — 퀘스트 클리어!`;
      document.getElementById('npcDialogText').textContent = `${formatGenderDialog(q.completeDialog)} (보상 지급: 경험치 +${q.rewardExp} / 골드 +${q.rewardGold}G)`;
      box.classList.remove('hidden');

      addLog(`🎊 [퀘스트 완료!] "${q.title}" 클리어! 경험치 +${q.rewardExp}, 골드 +${q.rewardGold}G 획득!`);
      grantExpAndGold(q.rewardExp, q.rewardGold, `${q.title} 완료`);
      updateAllUI();
    }

    function completeCurrentQuest() {
      const readyQ = QUESTS.find(q => {
        const qs = getQuestState(q.id);
        return qs.status === 'active' && qs.progress >= q.targetCount;
      });
      if (readyQ) {
        completeQuestById(readyQ.id, readyQ.giver);
      } else {
        addLog('[안내] 완료 조건을 달성한 진행 중 퀘스트가 없습니다. 조건을 만족한 뒤 해당 NPC와 대화하세요.');
      }
    }

    function onMonsterDefeated(m) {
      m.alive = false;
      m.timer = m.isBoss ? 9999 : 3.2;
      state.kills += 1;
      const p = state.player;
      p.gold += m.gold;
      p.exp += m.exp;
      addItemToInventory(m.drop, 1);
      spawnParticles(m.x, m.y, 40, ['#fde047', '#f43f5e', '#a855f7', '#4ade80'], 260, 6, 0.7);
      addLog(`🏆 [처치] Lv.${m.lv} ${m.name} 처치! +${m.exp} EXP, +${m.gold}G, [${ITEMS[m.drop].name}] 획득!`);

      const isGoblinKind = m.kind.startsWith('goblin');
      const isOrcKind = m.kind === 'elite_orc' || m.kind.startsWith('orc_');
      const isHeavyKind = ['goblin_brute', 'orc_juggernaut'].includes(m.kind);
      const isCoastalZone = state.zoneId.startsWith('coastal_road_');

      // 현재 NPC와 대화하여 '진행 중(active)'인 퀘스트만 카운트 증가! (미수락 상태에서는 카운트되지 않음)
      QUESTS.forEach(q => {
        const qs = getQuestState(q.id);
        if (qs.status !== 'active' || qs.progress >= q.targetCount) return;

        let matched = false;
        if (q.targetType === 'slime_kill' && m.kind === 'slime') matched = true;
        else if (q.targetType === 'goblin_kill' && isGoblinKind) matched = true;
        else if (q.targetType === 'broken_weapon' && isGoblinKind) matched = true;
        else if (q.targetType === 'orc_kill' && isOrcKind) matched = true;
        else if (q.targetType === 'balrog_kill' && m.isBoss) matched = true;
        else if (q.targetType === 'sub_goblin_kill' && isGoblinKind) matched = true;
        else if (q.targetType === 'sub_heavy_kill' && isHeavyKind) matched = true;
        else if (q.targetType === 'sub_coastal_kill' && isCoastalZone) matched = true;
        else if (q.targetType === 'sub_sea_orc_kill' && isCoastalZone && isOrcKind) matched = true;

        if (matched) {
          qs.progress = Math.min(q.targetCount, qs.progress + 1);
          state.effects.push({
            kind: 'dmg_text',
            x: state.player.x,
            y: state.player.y - 44,
            text: `📜 ${q.title.split(']')[1] || q.title} (${qs.progress}/${q.targetCount})`,
            color: '#38bdf8',
            ttl: 0.95
          });
          if (qs.progress >= q.targetCount) {
            soundFX.play('levelup');
            addLog(`✨ [퀘스트 목표 달성!] "${q.title}" (${qs.progress}/${q.targetCount}) 달성! 의뢰인 [${q.giver}]에게 돌아가 대화하세요!`);
          }
        }
      });

      let leveled = false;
      while (p.exp >= p.expNext) {
        p.exp -= p.expNext;
        p.level += 1;
        p.expNext = Math.round(p.expNext * 1.35);
        p.baseHp += 34;
        p.baseAtk += 7;
        p.baseDef += 3;
        p.sp += 1;
        const derived = getDerivedStats();
        p.hp = derived.maxHp;
        p.mp = derived.maxMp;
        leveled = true;
        soundFX.play('levelup');
        state.effects.push({ kind: 'dmg_text', x: p.x, y: p.y - 46, text: `🎉 LEVEL UP! Lv.${p.level}`, color: '#fde047', ttl: 1.1 });
        addLog(`🎉 레벨 업! Lv.${p.level} 달성! (스킬 포인트 +1 획득)`);
      }

      if (m.isBoss) {
        state.bossDefeated = true;
        soundFX.play('levelup');
        showResultScreen(true);
      }

      savePlayerProgress(leveled ? `Lv.${p.level} 레벨업` : '몬스터 처치');
    }

    function addItemToInventory(itemId, count) {
      const tpl = ITEMS[itemId];
      if (!tpl) return;
      const existing = state.player.inventory.find(i => i.id === itemId);
      if (existing) existing.count += count;
      else state.player.inventory.push({ ...tpl, count });
    }

    function handleWorldInteraction() {
      if (!isGameViewVisible()) return;
      if (state.isTalkingToNpc) {
        closeNpcDialog();
        return;
      }

      const p = state.player;
      const z = state.zones[state.zoneId];

      for (const portal of z.portals) {
        if (Math.hypot(p.x - portal.x, p.y - portal.y) <= portal.r + 45) {
          soundFX.play('levelup');
          switchZone(portal.target, portal.sx, portal.sy);
          return;
        }
      }
      for (const chest of z.chests) {
        if (!chest.opened && Math.hypot(p.x - chest.x, p.y - chest.y) <= 60) {
          chest.opened = true;
          p.gold += chest.gold;
          addItemToInventory(chest.item, 1);
          soundFX.play('levelup');
          spawnParticles(chest.x, chest.y, 30, ['#fde047', '#38bdf8', '#ffffff'], 200, 5, 0.6);
          state.effects.push({ kind: 'dmg_text', x: chest.x, y: chest.y - 24, text: `🎁 +${ITEMS[chest.item].name}`, color: '#fde047', ttl: 0.9 });
          addLog(`🎁 [보물상자 개봉] ${ITEMS[chest.item].name} 및 ${chest.gold}G 획득!`);
          savePlayerProgress('보물상자 획득');
          return;
        }
      }
      for (const npc of z.npcs) {
        if (Math.hypot(p.x - npc.x, p.y - npc.y) <= 75) {
          if (npc.questRole === 'merchant') {
            openShopModal(npc.name);
            return;
          }
          // 1순위: 이 NPC에게 보고하여 완료할 수 있는 진행 중(active) 퀘스트 확인
          const turnInQuest = QUESTS.find(q => {
            const qs = getQuestState(q.id);
            return qs.status === 'active' && qs.progress >= q.targetCount && q.turnInNpcId === npc.id;
          });
          if (turnInQuest) {
            completeQuestById(turnInQuest.id, npc.name);
            return;
          }

          // 2순위: 선행 조건이 충족되어 이 NPC와 대화하면 새로 시작(수락)할 수 있는 퀘스트 확인
          const availableQuest = QUESTS.find(q => {
            const qs = getQuestState(q.id);
            return qs.status === 'unaccepted' && q.giverId === npc.id && isQuestPrerequisiteMet(q);
          });
          if (availableQuest) {
            acceptQuestFromNpc(availableQuest, npc.name);
            return;
          }

          // 3순위: 일반 대화 (현재 진행 중인 퀘스트 안내 문구를 덧붙이지 않고 NPC 고유의 대사만 깔끔하게 표시!)
          state.isTalkingToNpc = true;
          const box = document.getElementById('npcDialogBox');
          document.getElementById('npcDialogSpeaker').textContent = `💬 ${npc.name}`;
          document.getElementById('npcDialogText').textContent = formatGenderDialog(npc.lines.join(' '));
          box.classList.remove('hidden');
          addLog(`⏸️ [NPC ${npc.name} 대화 중] 대사에 집중할 수 있도록 게임 월드가 일시정지되었습니다.`);
          return;
        }
      }
      addLog('[상호작용 안내] 포털, 보물상자, 또는 NPC 가까이 이동한 뒤 Enter(또는 F) 키를 누르세요.');
    }

    function switchZone(targetZoneId, sx = 120, sy = 300) {
      if (!state.zones[targetZoneId]) return;
      state.zoneId = targetZoneId;
      state.player.x = sx;
      state.player.y = sy;
      state.isTalkingToNpc = false;
      state.projectiles = [];
      state.slashArcs = [];
      // 맵 이동 시 기존 몬스터들을 삭제하고 초기 생성 위치(제자리)에 전체 체력으로 다시 소환!
      state.monsters = createInitialMonsters();
      document.getElementById('npcDialogBox').classList.add('hidden');
      spawnParticles(sx, sy, 25, ['#38bdf8', '#c084fc', '#ffffff'], 180, 5, 0.5);

      // 메인 6장(오션블루 타운 여정)이 수락(active)된 상태에서 오션블루 타운 진입 시 목표 달성!
      const q6State = getQuestState('main_6');
      if (q6State.status === 'active' && targetZoneId === 'oceanblue_town') {
        q6State.progress = 1;
        addLog('🌊 [오션블루 타운 도착!] 메인 6장 목표 달성! [오션블루 촌장 마리나]와 대화(Enter/F)하여 퀘스트를 완료하세요!');
      }

      const zObj = state.zones[targetZoneId];
      addLog(`📍 [지역 이동] ${zObj.name}${zObj.isSafeZone ? ' (🛡️ 적이 없는 안전지대 - HP/MP 자동 회복)' : ''}(으)로 진입했습니다!`);
      savePlayerProgress('지역 이동');
    }

    // ============================================================================
    // 6. 물리 충돌 & NPC 대화 / 모달 오픈 중 완전 일시정지 루프
    // ============================================================================
    function collidesObstacle(x, y, r) {
      const z = state.zones[state.zoneId];
      for (const ob of z.obstacles) {
        const cx = Math.max(ob.x, Math.min(x, ob.x + ob.w));
        const cy = Math.max(ob.y, Math.min(y, ob.y + ob.h));
        if (Math.hypot(x - cx, y - cy) < r) return true;
      }
      return false;
    }

    function resolveObstacleOverlap(entity) {
      const z = state.zones[state.zoneId];
      for (const ob of z.obstacles) {
        const cx = Math.max(ob.x, Math.min(entity.x, ob.x + ob.w));
        const cy = Math.max(ob.y, Math.min(entity.y, ob.y + ob.h));
        const dx = entity.x - cx;
        const dy = entity.y - cy;
        const dist = Math.hypot(dx, dy);
        if (dist < entity.r) {
          if (dist < 0.01) {
            entity.y = ob.y - entity.r - 2;
          } else {
            const push = (entity.r - dist) + 1.5;
            entity.x += (dx / dist) * push;
            entity.y += (dy / dist) * push;
          }
        }
      }
    }

    function stepSimulation(rawDt) {
      if (!isGameViewVisible() || state.gameOver || state.isTalkingToNpc || state.isModalOpen) return;

      if (state.hitStopTimer > 0) {
        state.hitStopTimer = Math.max(0, state.hitStopTimer - rawDt);
        return;
      }

      let worldDt = rawDt;
      if (state.bulletTimeTimer > 0) {
        state.bulletTimeTimer = Math.max(0, state.bulletTimeTimer - rawDt);
        worldDt = rawDt * 0.38;
      }

      const p = state.player;
      const derived = getDerivedStats();

      if (state.screenShake > 0) state.screenShake = Math.max(0, state.screenShake - rawDt * 38);
      if (p.comboTimer > 0) p.comboTimer = Math.max(0, p.comboTimer - rawDt);
      if (p.hitComboDecay > 0) {
        p.hitComboDecay = Math.max(0, p.hitComboDecay - rawDt);
        if (p.hitComboDecay === 0) p.hitCount = 0;
      }

      for (const k of Object.keys(state.cooldownLeft)) {
        if (state.cooldownLeft[k] > 0) {
          state.cooldownLeft[k] = Math.max(0, state.cooldownLeft[k] - rawDt);
        }
      }

      if (p.dodgeTimer > 0) {
        p.dodgeTimer = Math.max(0, p.dodgeTimer - rawDt);
        p.afterimages.push({ x: p.x, y: p.y, ttl: 0.22 });
      }
      p.afterimages = p.afterimages.filter(a => {
        a.ttl -= rawDt;
        return a.ttl > 0;
      });

      if (p.invulnTimer > 0) p.invulnTimer = Math.max(0, p.invulnTimer - rawDt);
      if (p.hitFlash > 0) p.hitFlash = Math.max(0, p.hitFlash - rawDt);
      const curZoneObj = state.zones[state.zoneId];
      if (curZoneObj && curZoneObj.isSafeZone) {
        p.hp = Math.min(derived.maxHp, p.hp + 32 * rawDt);
        p.mp = Math.min(derived.maxMp, p.mp + 22 * rawDt);
      } else {
        p.mp = Math.min(derived.maxMp, p.mp + 3.5 * rawDt);
      }

      state.sensor.gyroDeg = Math.max(0, state.sensor.gyroDeg - 320 * rawDt);
      state.sensor.accelG = Math.max(1.0, state.sensor.accelG - 2.6 * rawDt);
      state.sensor.pitch *= 0.88;
      state.sensor.roll *= 0.88;

      const useExt = state.sensor.joyX === 0 && state.sensor.joyY === 0;
      const jx = useExt ? state.sensor.extJoyX : state.sensor.joyX;
      const jy = useExt ? state.sensor.extJoyY : state.sensor.joyY;
      const mag = Math.hypot(jx, jy);
      if (mag >= 0.14) {
        const normX = jx / mag;
        const normY = jy / mag;
        p.fx = normX;
        p.fy = normY;
        const dashBoost = p.dodgeTimer > 0 ? 2.55 : 1.0;
        const nx = Math.max(26, Math.min(874, p.x + normX * derived.spd * dashBoost * Math.min(1, mag) * rawDt));
        const ny = Math.max(26, Math.min(574, p.y + normY * derived.spd * dashBoost * Math.min(1, mag) * rawDt));
        if (!collidesObstacle(nx, p.y, p.r)) p.x = nx;
        if (!collidesObstacle(p.x, ny, p.r)) p.y = ny;
        p.animTick += rawDt * 7.5;
      }
      resolveObstacleOverlap(p);

      const z = state.zones[state.zoneId];
      const nearInteractable =
        z.portals.some(pt => Math.hypot(p.x - pt.x, p.y - pt.y) <= pt.r + 45) ||
        z.chests.some(ch => !ch.opened && Math.hypot(p.x - ch.x, p.y - ch.y) <= 60) ||
        z.npcs.some(np => Math.hypot(p.x - np.x, p.y - np.y) <= 68);
      const hintBanner = document.getElementById('portalHintBanner');
      if (nearInteractable && !state.isTalkingToNpc) hintBanner.classList.remove('hidden');
      else hintBanner.classList.add('hidden');

      state.projectiles = state.projectiles.filter(proj => {
        const dt = proj.isEnemy ? worldDt : rawDt;
        proj.x += proj.vx * dt;
        proj.y += proj.vy * dt;
        proj.ttl -= dt;

        if (Math.random() < 0.5) {
          state.particles.push({
            x: proj.x, y: proj.y,
            vx: (Math.random() - 0.5) * 28, vy: (Math.random() - 0.5) * 28,
            size: 3, color: proj.color || '#fbbf24', ttl: 0.15, maxTtl: 0.15
          });
        }

        if (proj.isEnemy) {
          if (Math.hypot(p.x - proj.x, p.y - proj.y) <= proj.r + p.r) {
            if (p.invulnTimer > 0) {
              addLog('✨ [자이로 무적 회피!] 적의 마법 탄환을 흘려보냈습니다!');
            } else {
              const dmg = Math.max(1, proj.dmg - derived.def);
              p.hp = Math.max(0, p.hp - dmg);
              p.hitFlash = 0.18;
              state.screenShake = 6;
              updateRealtimeTelemetryUI();
              spawnParticles(p.x, p.y, 14, ['#f43f5e', '#ffffff'], 160, 4, 0.35);
              state.effects.push({ kind: 'dmg_text', x: p.x, y: p.y - 22, text: `-${dmg}`, color: '#f43f5e', ttl: 0.55 });
              if (p.hp <= 0) {
                triggerPlayerDeath();
              }
            }
            return false;
          }
        } else {
          for (const m of state.monsters) {
            if (m.zone === state.zoneId && m.alive) {
              if (Math.hypot(m.x - proj.x, m.y - proj.y) <= proj.r + m.r) {
                m.hp = Math.max(0, m.hp - proj.dmg);
                m.flash = 0.16;
                p.hitCount += 1;
                p.hitComboDecay = 3.0;
                spawnParticles(m.x, m.y, 16, ['#f97316', '#fde047', '#ffffff'], 180, 5, 0.4);
                state.effects.push({ kind: 'dmg_text', x: m.x, y: m.y - 20, text: `🔥-${proj.dmg}`, color: '#fb923c', ttl: 0.55 });
                if (m.hp <= 0) onMonsterDefeated(m);
                return false;
              }
            }
          }
        }
        return proj.ttl > 0 && proj.x > 0 && proj.x < 900 && proj.y > 0 && proj.y < 600;
      });

      let bossVulnerableActive = false;
      const zoneMonsters = state.monsters.filter(m => m.zone === state.zoneId);

      for (const m of zoneMonsters) {
        if (!m.alive) {
          m.timer -= worldDt;
          if (m.timer <= 0 && !m.isBoss) {
            m.alive = true;
            m.hp = m.maxHp;
            m.x = m.sx;
            m.y = m.sy;
            m.vx = 0;
            m.vy = 0;
            m.state = 'IDLE';
          }
          continue;
        }
        if (m.flash > 0) m.flash = Math.max(0, m.flash - rawDt);

        if (Math.hypot(m.vx, m.vy) > 2) {
          m.x = Math.max(32, Math.min(868, m.x + m.vx * worldDt));
          m.y = Math.max(32, Math.min(568, m.y + m.vy * worldDt));
          m.vx *= Math.pow(0.05, worldDt);
          m.vy *= Math.pow(0.05, worldDt);
        } else {
          m.vx = 0;
          m.vy = 0;
        }

        const dist = Math.hypot(p.x - m.x, p.y - m.y);
        const isRangedKind = ['elite_mage', 'goblin_archer', 'goblin_shaman', 'orc_shaman'].includes(m.kind);
        const isHeavyKind = ['goblin_brute', 'orc_juggernaut'].includes(m.kind);
        const detectR = m.isBoss ? 600 : (360 + m.lv * 12);
        // 근접 몬스터가 데드존(atkR ~ atkR+6)에 멈추지 않고 플레이어 바로 앞까지 파고들어 공격하도록 사거리 정밀화
        const atkR = m.isBoss ? 120 : (isRangedKind ? 235 : (isHeavyKind ? (p.r + m.r + 18) : (p.r + m.r + 12)));
        const curSpd = m.spd * (m.enraged ? 1.32 : 1.0);

        if (m.state === 'IDLE') {
          m.animPhase += worldDt * 3.0;
          if (dist < detectR) m.state = 'CHASE';
        } else if (m.state === 'CHASE') {
          m.animPhase += worldDt * 5.6;
          if (dist <= atkR) {
            m.state = 'TELEGRAPH';
            if (m.isBoss) {
              const patterns = ['flame_breath', 'abyss_charge', 'meteor_nova'];
              m.pattern = patterns[m.patIdx % patterns.length];
              m.patIdx += 1;
              m.timer = m.enraged ? 0.72 : 0.90;
            } else {
              m.timer = isRangedKind ? 0.52 : (isHeavyKind ? 0.45 : 0.34);
            }
            m.tx = p.x;
            m.ty = p.y;
          } else {
            // 데드존 없이 플레이어에게 끝까지 접근!
            let dirX = (p.x - m.x) / Math.max(1, dist);
            let dirY = (p.y - m.y) / Math.max(1, dist);
            for (const other of zoneMonsters) {
              if (other !== m && other.alive) {
                const od = Math.hypot(m.x - other.x, m.y - other.y);
                const minSep = m.r + other.r - 4;
                if (od > 0.1 && od < minSep) {
                  dirX += ((m.x - other.x) / od) * 0.28;
                  dirY += ((m.y - other.y) / od) * 0.28;
                }
              }
            }
            const dirLen = Math.max(0.01, Math.hypot(dirX, dirY));
            m.x = Math.max(32, Math.min(868, m.x + (dirX / dirLen) * curSpd * worldDt));
            m.y = Math.max(32, Math.min(568, m.y + (dirY / dirLen) * curSpd * worldDt));
          }
        } else if (m.state === 'TELEGRAPH') {
          // 근접 몬스터는 공격 전조 중에도 플레이어 쪽으로 살짝 전진(Lunge)하여 헛방 방지
          if (!isRangedKind && dist > p.r + m.r - 2) {
            const lx = (p.x - m.x) / Math.max(1, dist);
            const ly = (p.y - m.y) / Math.max(1, dist);
            m.x = Math.max(32, Math.min(868, m.x + lx * curSpd * 0.55 * worldDt));
            m.y = Math.max(32, Math.min(568, m.y + ly * curSpd * 0.55 * worldDt));
          }
          m.timer -= worldDt;
          if (m.timer <= 0) {
            m.state = 'ATTACK';
            m.timer = 0.26;
            const nowDist = Math.hypot(p.x - m.x, p.y - m.y);

            if (isRangedKind) {
              const baseAng = Math.atan2(p.y - m.y, p.x - m.x);
              const spreads = m.kind === 'goblin_archer' ? [0] : (m.kind === 'goblin_shaman' ? [-0.14, 0.14] : [-0.20, 0, 0.20]);
              const projSpd = 265 + m.lv * 12;
              const projColor = m.kind === 'goblin_archer' ? '#a3e635' : (m.kind === 'goblin_shaman' ? '#c084fc' : '#f43f5e');
              spreads.forEach(off => {
                state.projectiles.push({
                  x: m.x, y: m.y,
                  vx: Math.cos(baseAng + off) * projSpd, vy: Math.sin(baseAng + off) * projSpd,
                  r: m.kind === 'goblin_archer' ? 8 : 10, dmg: m.atk, color: projColor, ttl: 2.2, isEnemy: true
                });
              });
            } else {
              const hitR = m.isBoss ? 146 : (isHeavyKind ? 94 : 76);
              state.effects.push({ kind: 'enemy_aoe', x: m.x, y: m.y, r: hitR, ttl: 0.30, maxTtl: 0.30 });
              if (m.isBoss) {
                state.screenShake = 12;
                const bulletCount = m.enraged ? 12 : 8;
                for (let b = 0; b < bulletCount; b++) {
                  const bang = (Math.PI * 2 * b) / bulletCount + (m.patIdx * 0.25);
                  state.projectiles.push({
                    x: m.x, y: m.y,
                    vx: Math.cos(bang) * (m.enraged ? 250 : 215),
                    vy: Math.sin(bang) * (m.enraged ? 250 : 215),
                    r: 10, dmg: Math.round(m.atk * 0.85), color: '#f43f5e', ttl: 2.4, isEnemy: true
                  });
                }
              }
              if (nowDist <= hitR + p.r) {
                if (p.invulnTimer > 0) {
                  addLog(`✨ [자이로 무적 회피 성공!] ${m.name}의 강타를 완벽히 흘려보냈습니다!`);
                } else {
                  const rawAtk = m.isBoss && m.enraged ? Math.round(m.atk * 1.30) : m.atk;
                  const dmg = Math.max(1, rawAtk - derived.def);
                  p.hp = Math.max(0, p.hp - dmg);
                  p.hitFlash = 0.22;
                  state.screenShake = 10;
                  updateRealtimeTelemetryUI();
                  spawnParticles(p.x, p.y, 20, ['#f43f5e', '#ffffff'], 190, 5, 0.45);
                  state.effects.push({ kind: 'dmg_text', x: p.x, y: p.y - 22, text: `❗-${dmg}`, color: '#f43f5e', ttl: 0.6 });
                  addLog(`❗ [피격] Lv.${m.lv} ${m.name}의 근접 공격에 ${dmg} 피해를 입었습니다.`);
                  if (p.hp <= 0) {
                    triggerPlayerDeath();
                  }
                }
              }
            }
          }
        } else if (m.state === 'ATTACK') {
          m.timer -= worldDt;
          if (m.timer <= 0) {
            if (m.isBoss) {
              m.state = 'VULNERABLE';
              m.timer = m.enraged ? 1.90 : 2.40;
            } else {
              m.state = 'CHASE';
            }
          }
        } else if (m.state === 'VULNERABLE') {
          bossVulnerableActive = true;
          m.timer -= worldDt;
          if (m.timer <= 0) m.state = 'CHASE';
        }
      }

      const banner = document.getElementById('bossCounterBanner');
      if (bossVulnerableActive) banner.classList.remove('hidden');
      else banner.classList.add('hidden');

      state.slashArcs = state.slashArcs.filter(arc => {
        arc.ttl -= rawDt;
        return arc.ttl > 0;
      });
      state.particles = state.particles.filter(pt => {
        pt.x += pt.vx * rawDt;
        pt.y += pt.vy * rawDt;
        pt.vy += 180 * rawDt;
        pt.ttl -= rawDt;
        return pt.ttl > 0;
      });
      state.effects = state.effects.filter(ef => {
        ef.ttl -= rawDt;
        return ef.ttl > 0;
      });
    }

    // ============================================================================
    // 7. 64×64 HD 픽셀 아트 렌더러 & 시작 화면 상태 프리뷰 렌더러
    // ============================================================================
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    ctx.imageSmoothingEnabled = false;

    const imuCanvas = document.getElementById('imuBoardCanvas');
    const ictx = imuCanvas.getContext('2d');

    const statusPreviewCanvas = document.getElementById('statusPreviewCanvas');
    const spctx = statusPreviewCanvas.getContext('2d');
    spctx.imageSmoothingEnabled = false;

    function renderStartStatusPreview() {
      spctx.clearRect(0, 0, 128, 128);
      const spr = getHD64Sprite(state.selectedClass);
      spctx.drawImage(spr, 0, 0, 128, 128);
    }

    const LOGICAL_W = 900;
    const LOGICAL_H = 600;
    let frameDomBadges = [];

    // 캔버스 내부가 아닌 브라우저 네이티브 HTML DOM 벡터 폰트 레이어(#canvasDomLabels)에 배지를 등록하여 흐림 현상을 0%로 원천 제거!
    function drawCanvasPill(c, text, x, y, textColor = '#ffffff', borderColor = '#334155', bgColor = '#05070e') {
      const clampedX = Math.max(68, Math.min(LOGICAL_W - 68, x));
      const clampedY = Math.max(18, Math.min(LOGICAL_H - 14, y));
      frameDomBadges.push({
        text,
        xPct: (clampedX / LOGICAL_W) * 100,
        yPct: (clampedY / LOGICAL_H) * 100,
        textColor,
        borderColor,
        bgColor
      });
    }

    function syncDomLabelsToScreen() {
      const layer = document.getElementById('canvasDomLabels');
      if (!layer) return;
      // #gameCanvas의 실제 화면 표시 영역과 정확히 일치하도록 위치/크기 동기화
      layer.style.left = `${canvas.offsetLeft}px`;
      layer.style.top = `${canvas.offsetTop}px`;
      layer.style.width = `${canvas.clientWidth}px`;
      layer.style.height = `${canvas.clientHeight}px`;

      layer.innerHTML = frameDomBadges.map(b => `
        <div style="left:${b.xPct.toFixed(2)}%; top:${b.yPct.toFixed(2)}%; transform:translate(-50%, -50%); color:${b.textColor}; border-color:${b.borderColor}; background-color:#05070e;"
             class="absolute px-2 py-0.5 rounded-md border text-[11px] sm:text-xs font-extrabold tracking-tight leading-none whitespace-nowrap shadow-md">
          ${b.text}
        </div>
      `).join('');
    }

    function renderCanvas(nowMs) {
      const z = state.zones[state.zoneId];
      const p = state.player;
      const animClock = state.isTalkingToNpc ? 0 : nowMs;
      frameDomBadges = [];

      ctx.save();
      // 1800x1200 (2배 고해상도 버퍼)에 맞춰 2x 스케일링 적용 -> 도트 그래픽 선명도 2배 향상
      ctx.setTransform(2, 0, 0, 2, 0, 0);
      ctx.imageSmoothingEnabled = false;

      if (state.screenShake > 0 && !state.isTalkingToNpc) {
        const sx = (Math.random() - 0.5) * state.screenShake * 1.5;
        const sy = (Math.random() - 0.5) * state.screenShake * 1.5;
        ctx.translate(sx, sy);
      }

      ctx.fillStyle = z.bgPrimary;
      ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);

      const tileSize = 45;
      for (let gx = 0; gx < LOGICAL_W; gx += tileSize) {
        for (let gy = 0; gy < LOGICAL_H; gy += tileSize) {
          const hash = ((gx * 13 + gy * 37) % 7);
          if (hash < 3) {
            ctx.fillStyle = z.bgSecondary;
            ctx.fillRect(gx + 2, gy + 2, tileSize - 4, tileSize - 4);
          }
          if (hash === 0) {
            ctx.fillStyle = z.accentColor;
            ctx.globalAlpha = 0.20;
            ctx.fillRect(gx + 14, gy + 18, 4, 8);
            ctx.fillRect(gx + 20, gy + 14, 4, 12);
            ctx.globalAlpha = 1.0;
          }
        }
      }

      if (state.bulletTimeTimer > 0) {
        ctx.fillStyle = 'rgba(16, 185, 129, 0.12)';
        ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);
      }

      for (const ef of state.effects) {
        if (ef.kind === 'quake_crater') {
          ctx.save();
          ctx.translate(ef.x, ef.y);
          const alpha = ef.ttl / ef.maxTtl;
          ctx.strokeStyle = `rgba(249, 115, 22, ${alpha})`;
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.arc(0, 0, ef.r * (1.1 - alpha * 0.25), 0, Math.PI * 2);
          ctx.stroke();
          for (let i = 0; i < 8; i++) {
            const a = (Math.PI * 2 * i) / 8;
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.lineTo(Math.cos(a) * ef.r, Math.sin(a) * ef.r);
            ctx.stroke();
          }
          ctx.restore();
        } else if (ef.kind === 'arcane_circle') {
          ctx.save();
          ctx.translate(ef.x, ef.y);
          ctx.rotate(animClock * 0.004);
          const alpha = ef.ttl / ef.maxTtl;
          ctx.strokeStyle = `rgba(192, 132, 252, ${alpha})`;
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(0, 0, ef.r, 0, Math.PI * 2);
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(0, 0, ef.r * 0.72, 0, Math.PI * 2);
          ctx.stroke();
          for (let t = 0; t < 2; t++) {
            ctx.beginPath();
            for (let i = 0; i < 4; i++) {
              const a = t * (Math.PI / 3) + (i * Math.PI * 2) / 3;
              const px = Math.cos(a) * ef.r * 0.85;
              const py = Math.sin(a) * ef.r * 0.85;
              if (i === 0) ctx.moveTo(px, py);
              else ctx.lineTo(px, py);
            }
            ctx.stroke();
          }
          ctx.restore();
        } else if (ef.kind === 'enemy_aoe') {
          ctx.fillStyle = 'rgba(244, 63, 94, 0.35)';
          ctx.beginPath();
          ctx.arc(ef.x, ef.y, ef.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      for (const torch of (z.torches || [])) {
        const flicker = 28 + Math.sin(animClock * 0.012 + torch.x) * 4;
        const grad = ctx.createRadialGradient(torch.x, torch.y, 2, torch.x, torch.y, flicker * 2.2);
        grad.addColorStop(0, 'rgba(251, 191, 36, 0.42)');
        grad.addColorStop(1, 'rgba(251, 191, 36, 0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(torch.x, torch.y, flicker * 2.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#78350f';
        ctx.fillRect(torch.x - 3, torch.y, 6, 14);
        ctx.fillStyle = '#fde047';
        ctx.fillRect(torch.x - 4, torch.y - 6, 8, 7);
      }

      for (const ob of z.obstacles) {
        const spr = getHD64Sprite(ob.kind || 'pillar');
        ctx.drawImage(spr, ob.x, ob.y, ob.w, ob.h);
      }

      for (const portal of z.portals) {
        ctx.save();
        ctx.translate(Math.round(portal.x), Math.round(portal.y));
        ctx.rotate(animClock * 0.003);
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 3.5;
        ctx.setLineDash([8, 6]);
        ctx.beginPath();
        ctx.arc(0, 0, portal.r, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();

        ctx.fillStyle = 'rgba(56, 189, 248, 0.25)';
        ctx.beginPath();
        ctx.arc(Math.round(portal.x), Math.round(portal.y), portal.r - 4, 0, Math.PI * 2);
        ctx.fill();

        drawCanvasPill(ctx, portal.label, portal.x, portal.y - portal.r - 14, '#fde047', '#38bdf8');
      }

      for (const chest of z.chests) {
        ctx.save();
        const cx = Math.round(chest.x), cy = Math.round(chest.y);
        ctx.fillStyle = 'rgba(0,0,0,0.45)';
        ctx.fillRect(cx - 16, cy + 8, 32, 6);
        ctx.fillStyle = chest.opened ? '#475569' : '#d97706';
        ctx.fillRect(cx - 15, cy - 12, 30, 22);
        ctx.fillStyle = '#fde047';
        ctx.fillRect(cx - 15, cy - 3, 30, 4);
        ctx.fillRect(cx - 3, cy - 6, 6, 9);
        ctx.restore();
        drawCanvasPill(ctx, chest.opened ? '상자 열림' : '🎁 보물상자 (F)', chest.x, chest.y - 24, chest.opened ? '#94a3b8' : '#fde047', '#f59e0b');
      }

      for (const npc of z.npcs) {
        const spr = getHD64Sprite(npc.sprite || 'mage');
        ctx.drawImage(spr, Math.round(npc.x - 35), Math.round(npc.y - 35), 70, 70);

        const hasTurnIn = QUESTS.some(q => {
          const qs = getQuestState(q.id);
          return qs.status === 'active' && qs.progress >= q.targetCount && q.turnInNpcId === npc.id;
        });
        const hasAvailable = QUESTS.some(q => {
          const qs = getQuestState(q.id);
          return qs.status === 'unaccepted' && q.giverId === npc.id && isQuestPrerequisiteMet(q);
        });

        let npcLabel = `💬 ${npc.name} (Enter/F)`;
        let npcTextColor = '#fde047';
        let npcBorder = '#f59e0b';
        if (npc.questRole === 'merchant') {
          npcLabel = `🏪 [워프/잡화 상점] ${npc.name} (Enter/F)`;
          npcTextColor = '#a7f3d0';
          npcBorder = '#10b981';
        } else if (hasTurnIn) {
          npcLabel = `🎁 [완료 보고] ${npc.name} (F)`;
          npcTextColor = '#34d399';
          npcBorder = '#10b981';
        } else if (hasAvailable) {
          npcLabel = `❗ [퀘스트 수락] ${npc.name} (F)`;
          npcTextColor = '#38bdf8';
          npcBorder = '#0284c7';
        }
        drawCanvasPill(ctx, npcLabel, npc.x, npc.y - 44, npcTextColor, npcBorder);
      }

      for (const m of state.monsters) {
        if (m.zone !== state.zoneId || !m.alive) continue;
        const mx = Math.round(m.x), my = Math.round(m.y);
        ctx.save();
        ctx.translate(mx, my);

        if (m.state === 'TELEGRAPH') {
          const r = m.isBoss ? 146 : (['goblin_brute', 'orc_juggernaut'].includes(m.kind) ? 94 : 76);
          ctx.fillStyle = 'rgba(244, 63, 94, 0.26)';
          ctx.strokeStyle = '#f43f5e';
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.arc(0, 0, r, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        } else if (m.state === 'VULNERABLE') {
          ctx.strokeStyle = '#fde047';
          ctx.lineWidth = 3;
          ctx.setLineDash([6, 4]);
          ctx.beginPath();
          ctx.arc(0, 0, m.r + 14, 0, Math.PI * 2);
          ctx.stroke();
          ctx.setLineDash([]);
        } else if (m.isBoss && m.enraged) {
          ctx.strokeStyle = 'rgba(244, 63, 94, 0.65)';
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.arc(0, 0, m.r + 8, 0, Math.PI * 2);
          ctx.stroke();
        }

        const gentleBob = Math.round(Math.sin(m.animPhase) * 2.0);
        const spr = getHD64Sprite(m.kind, m.flash > 0);
        const drawW = m.isBoss ? 114 : 66;
        const drawH = m.isBoss ? 114 : 66;
        ctx.fillStyle = 'rgba(0,0,0,0.45)';
        ctx.beginPath();
        ctx.ellipse(0, drawH / 2 - 6, drawW * 0.34, 6, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.save();
        if (p.x < m.x) ctx.scale(-1, 1);
        ctx.drawImage(spr, -drawW / 2, -drawH / 2 + gentleBob, drawW, drawH);
        ctx.restore();

        const bw = m.isBoss ? 96 : 52;
        const ratio = Math.max(0, m.hp / m.maxHp);
        ctx.fillStyle = '#090d16';
        ctx.fillRect(-bw / 2, -drawH / 2 - 10, bw, 7);
        ctx.fillStyle = m.isBoss ? '#f43f5e' : (m.lv >= 6 ? '#a855f7' : '#10b981');
        ctx.fillRect(-bw / 2 + 1, -drawH / 2 - 9, Math.round((bw - 2) * ratio), 5);
        ctx.restore();

        drawCanvasPill(ctx, `Lv.${m.lv} ${m.name}`, mx, my - drawH / 2 - 22, m.isBoss ? '#fda4af' : '#f8fafc', '#475569');
      }

      const pSpr = getHD64Sprite(state.selectedClass);
      for (const aft of p.afterimages) {
        ctx.save();
        ctx.globalAlpha = (aft.ttl / 0.22) * 0.55;
        ctx.drawImage(pSpr, Math.round(aft.x - 34), Math.round(aft.y - 34), 68, 68);
        ctx.restore();
      }

      const px = Math.round(p.x), py = Math.round(p.y);
      ctx.save();
      ctx.translate(px, py);
      if (p.invulnTimer > 0) {
        ctx.strokeStyle = '#34d399';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.arc(0, 0, 28, 0, Math.PI * 2);
        ctx.stroke();
      }
      const walkBob = Math.round(Math.sin(p.animTick) * 2.0);
      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      ctx.beginPath();
      ctx.ellipse(0, 22, 16, 5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.save();
      if (p.fx < 0) ctx.scale(-1, 1);
      const pRenderSpr = getHD64Sprite(state.selectedClass, (p.hitFlash || 0) > 0);
      ctx.drawImage(pRenderSpr, -34, -34 + walkBob, 68, 68);
      ctx.restore();

      const pDerived = getDerivedStats();
      const pHpRatio = Math.max(0, Math.min(1, p.hp / Math.max(1, pDerived.maxHp)));
      const pBarW = 56;
      ctx.fillStyle = '#090d16';
      ctx.fillRect(-pBarW / 2, -35, pBarW, 7);
      ctx.fillStyle = pHpRatio > 0.5 ? '#22c55e' : (pHpRatio > 0.25 ? '#f59e0b' : '#f43f5e');
      ctx.fillRect(-pBarW / 2 + 1, -34, Math.round((pBarW - 2) * pHpRatio), 5);
      ctx.restore();

      drawCanvasPill(ctx, `Lv.${p.level} (${Math.round(p.hp)}/${pDerived.maxHp})`, px, py - 47, '#38bdf8', '#0284c7');

      for (const arc of state.slashArcs) {
        ctx.save();
        ctx.translate(arc.x, arc.y);
        const progress = 1 - arc.ttl / arc.maxTtl;
        const startA = arc.angle - (arc.sweep / 2) * arc.dir;
        const endA = arc.angle + (arc.sweep / 2) * arc.dir;
        ctx.globalAlpha = Math.min(1, (arc.ttl / arc.maxTtl) * 1.4);

        ctx.strokeStyle = arc.color;
        ctx.lineWidth = 14 * (1 - progress * 0.4);
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.arc(0, 0, arc.radius, Math.min(startA, endA), Math.max(startA, endA));
        ctx.stroke();

        ctx.strokeStyle = arc.coreColor;
        ctx.lineWidth = 5 * (1 - progress * 0.5);
        ctx.beginPath();
        ctx.arc(0, 0, arc.radius, Math.min(startA, endA), Math.max(startA, endA));
        ctx.stroke();
        ctx.restore();
      }

      for (const proj of state.projectiles) {
        ctx.save();
        ctx.fillStyle = proj.color || '#f97316';
        ctx.beginPath();
        ctx.arc(proj.x, proj.y, proj.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(proj.x, proj.y, proj.r * 0.45, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      for (const pt of state.particles) {
        ctx.fillStyle = pt.color;
        ctx.globalAlpha = Math.max(0, pt.ttl / pt.maxTtl);
        ctx.fillRect(Math.round(pt.x), Math.round(pt.y), pt.size, pt.size);
      }
      ctx.globalAlpha = 1.0;

      for (const ef of state.effects) {
        if (ef.kind === 'dmg_text') {
          const ex = Math.round(ef.x);
          const ey = Math.round(ef.y - (0.65 - ef.ttl) * 28);
          drawCanvasPill(ctx, ef.text, ex, ey, ef.color || '#fde047', '#fbbf24');
        }
      }

      if (state.isTalkingToNpc) {
        ctx.fillStyle = 'rgba(5, 7, 14, 0.48)';
        ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);
      }

      ctx.save();
      const mmX = LOGICAL_W - 132, mmY = 12, mmW = 120, mmH = 80;
      ctx.fillStyle = 'rgba(9, 13, 22, 0.88)';
      ctx.strokeStyle = '#475569';
      ctx.lineWidth = 2;
      ctx.fillRect(mmX, mmY, mmW, mmH);
      ctx.strokeRect(mmX, mmY, mmW, mmH);
      ctx.fillStyle = '#38bdf8';
      ctx.fillRect(mmX + (p.x / LOGICAL_W) * mmW - 2, mmY + (p.y / LOGICAL_H) * mmH - 2, 5, 5);
      for (const m of state.monsters) {
        if (m.zone === state.zoneId && m.alive) {
          ctx.fillStyle = m.isBoss ? '#f43f5e' : '#fbbf24';
          ctx.fillRect(mmX + (m.x / LOGICAL_W) * mmW - 2, mmY + (m.y / LOGICAL_H) * mmH - 2, m.isBoss ? 6 : 4, m.isBoss ? 6 : 4);
        }
      }
      ctx.restore();

      ctx.restore();
      syncDomLabelsToScreen();
    }

    function renderImuBoard() {
      ictx.clearRect(0, 0, imuCanvas.width, imuCanvas.height);
      const cx = imuCanvas.width / 2;
      const cy = imuCanvas.height / 2 + 4;

      const tiltX = state.sensor.joyX * 0.35 + (state.sensor.roll * Math.PI) / 180;
      const tiltY = state.sensor.joyY * 0.35 + (state.sensor.pitch * Math.PI) / 180;

      ictx.save();
      ictx.translate(cx, cy);
      ictx.scale(1, 0.65 + Math.sin(tiltY) * 0.18);
      ictx.rotate(tiltX * 0.6);

      ictx.fillStyle = '#0f5132';
      ictx.strokeStyle = '#34d399';
      ictx.lineWidth = 2;
      ictx.fillRect(-52, -32, 104, 64);
      ictx.strokeRect(-52, -32, 104, 64);

      ictx.fillStyle = '#64748b';
      ictx.fillRect(-44, -22, 34, 30);
      ictx.fillStyle = '#e2e8f0';
      ictx.font = 'bold 8px monospace';
      ictx.fillText('ESP32', -39, -4);

      const imuActive = state.sensor.gyroDeg > 80 || state.sensor.accelG > 1.6;
      ictx.fillStyle = imuActive ? '#f43f5e' : '#1e293b';
      ictx.strokeStyle = '#38bdf8';
      ictx.fillRect(-2, -20, 26, 22);
      ictx.strokeRect(-2, -20, 26, 22);
      ictx.fillStyle = '#38bdf8';
      ictx.fillText('MPU', 2, -6);

      ictx.fillStyle = state.sensor.touch0Active ? '#c084fc' : '#3b0764';
      ictx.fillRect(28, -24, 18, 18);
      ictx.fillStyle = '#ffffff';
      ictx.fillText('T0', 32, -12);

      ictx.fillStyle = state.sensor.touch3Active ? '#818cf8' : '#1e1b4b';
      ictx.fillRect(28, 2, 18, 18);
      ictx.fillStyle = '#ffffff';
      ictx.fillText('T3', 32, 14);

      ictx.restore();
    }

    // ============================================================================
    // 8. DOM UI 동기화 & 모달 제어 (인벤토리/장비창 및 스킬 강화창)
    // ============================================================================
    function renderLogs() {
      const container = document.getElementById('combatLogList');
      container.innerHTML = state.logs.map(l => `<div class="leading-snug">${l}</div>`).join('');
