    function buyShopItem(itemId) {
      const tpl = ITEMS[itemId];
      if (!tpl) return;
      const price = tpl.price || 100;
      if (state.player.gold < price) {
        addLog(`❗ [골드 부족] [${tpl.name}] 구매에 ${price}G가 필요합니다. (현재 보유: ${state.player.gold}G)`);
        return;
      }
      state.player.gold -= price;
